{
  "_comment": "Shared conformance cases for the JSON -> tf.Example converters (Classify/Regress input). Each suite converts `input` and compares the result, normalized to {\"examples\": [{feature: {list_type: [values]}}], \"context\": {...}}, with `expect`; or requires an error. Float values are exactly representable in float32.",
  "cases": [
    {"name": "decimals infer float_list", "input": {"examples": [{"a": 1.5, "b": [0.25, 2.0]}]},
     "expect": {"examples": [{"a": {"float_list": [1.5]}, "b": {"float_list": [0.25, 2.0]}}]}},
    {"name": "integers infer int64_list", "input": {"examples": [{"n": 3, "ids": [1, -2, 9007199254740993]}]},
     "expect": {"examples": [{"ids": {"int64_list": [1, -2, 9007199254740993]}, "n": {"int64_list": [3]}}]}},
    {"name": "integers mixed with decimals infer float_list", "input": {"examples": [{"x": [1, 2.5]}]},
     "expect": {"examples": [{"x": {"float_list": [1.0, 2.5]}}]}},
    {"name": "strings infer bytes_list", "input": {"examples": [{"city": "Austin", "tags": ["a", "münchen"]}]},
     "expect": {"examples": [{"city": {"bytes_list": ["Austin"]}, "tags": {"bytes_list": ["a", "münchen"]}}]}},
    {"name": "b64 object is raw bytes", "input": {"examples": [{"raw": [{"b64": "aGVsbG8="}, "world"]}]},
     "expect": {"examples": [{"raw": {"bytes_list": ["hello", "world"]}}]}},
    {"name": "explicit float_list accepts integers", "input": {"examples": [{"x": {"float_list": [5, 3]}}]},
     "expect": {"examples": [{"x": {"float_list": [5.0, 3.0]}}]}},
    {"name": "explicit scalar is wrapped", "input": {"examples": [{"x": {"float_list": 5}}]},
     "expect": {"examples": [{"x": {"float_list": [5.0]}}]}},
    {"name": "explicit empty list", "input": {"examples": [{"x": {"int64_list": []}, "y": {"bytes_list": []}}]},
     "expect": {"examples": [{"x": {"int64_list": []}, "y": {"bytes_list": []}}]}},
    {"name": "several examples", "input": {"examples": [{"a": 1.5}, {"a": 2.5, "b": 1}]},
     "expect": {"examples": [{"a": {"float_list": [1.5]}}, {"a": {"float_list": [2.5]}, "b": {"int64_list": [1]}}]}},
    {"name": "empty example object", "input": {"examples": [{}]},
     "expect": {"examples": [{}]}},
    {"name": "context", "input": {"examples": [{"a": 1.5}], "context": {"site": "lab"}},
     "expect": {"examples": [{"a": {"float_list": [1.5]}}], "context": {"site": {"bytes_list": ["lab"]}}}},

    {"name": "missing examples", "input": {"inputs": {}}, "error": true},
    {"name": "empty examples", "input": {"examples": []}, "error": true},
    {"name": "unknown top-level key", "input": {"examples": [{"a": 1}], "extra": 1}, "error": true},
    {"name": "example is not an object", "input": {"examples": [[1, 2]]}, "error": true},
    {"name": "context is not an object", "input": {"examples": [{"a": 1}], "context": 3}, "error": true},
    {"name": "empty list needs explicit type", "input": {"examples": [{"a": []}]}, "error": true},
    {"name": "nested arrays", "input": {"examples": [{"a": [[1, 2]]}]}, "error": true},
    {"name": "mixed strings and numbers", "input": {"examples": [{"a": ["x", 1]}]}, "error": true},
    {"name": "booleans", "input": {"examples": [{"a": true}]}, "error": true},
    {"name": "null", "input": {"examples": [{"a": null}]}, "error": true},
    {"name": "int64 overflow", "input": {"examples": [{"a": 9223372036854775808}]}, "error": true},
    {"name": "explicit int64_list rejects decimals", "input": {"examples": [{"a": {"int64_list": [1.5]}}]}, "error": true},
    {"name": "explicit bytes_list rejects numbers", "input": {"examples": [{"a": {"bytes_list": [1]}}]}, "error": true},
    {"name": "explicit float_list rejects strings", "input": {"examples": [{"a": {"float_list": ["1"]}}]}, "error": true},
    {"name": "unknown explicit list type", "input": {"examples": [{"a": {"double_list": [1.5]}}]}, "error": true},
    {"name": "explicit object with two keys", "input": {"examples": [{"a": {"float_list": [1.5], "int64_list": [1]}}]}, "error": true},
    {"name": "invalid base64", "input": {"examples": [{"a": {"b64": "not base64!"}}]}, "error": true},
    {"name": "b64 object with extra key", "input": {"examples": [{"a": {"b64": "aGk=", "x": 1}}]}, "error": true}
  ]
}
