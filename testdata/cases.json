{
  "_comment": "Shared conformance cases. The Python, Go and Rust test suites all load this file, convert `input` with their JSON->TensorProto converter, and compare with `expect` (dtype, shape, flat row-major values) or require an error.",
  "cases": [
    {"name": "int vector infers int64", "input": [1, 2, 3],
     "expect": {"dtype": "DT_INT64", "shape": [3], "values": [1, 2, 3]}},
    {"name": "decimal vector infers float32", "input": [1.5, 2.25],
     "expect": {"dtype": "DT_FLOAT", "shape": [2], "values": [1.5, 2.25]}},
    {"name": "mixed int and decimal infers float32", "input": [1, 2.5, 3],
     "expect": {"dtype": "DT_FLOAT", "shape": [3], "values": [1, 2.5, 3]}},
    {"name": "scalar has rank 0", "input": 3.0,
     "expect": {"dtype": "DT_FLOAT", "shape": [], "values": [3.0]}},
    {"name": "scalar string", "input": "hello",
     "expect": {"dtype": "DT_STRING", "shape": [], "values": ["hello"]}},
    {"name": "bool matrix", "input": [[true, false], [false, true]],
     "expect": {"dtype": "DT_BOOL", "shape": [2, 2], "values": [true, false, false, true]}},
    {"name": "string vector with unicode", "input": ["austin", "münchen"],
     "expect": {"dtype": "DT_STRING", "shape": [2], "values": ["austin", "münchen"]}},
    {"name": "b64 leaf becomes raw bytes", "input": [{"b64": "aGVsbG8="}, "world"],
     "expect": {"dtype": "DT_STRING", "shape": [2], "values": ["hello", "world"]}},
    {"name": "2x3 matrix", "input": [[1, 2, 3], [4, 5, 6]],
     "expect": {"dtype": "DT_INT64", "shape": [2, 3], "values": [1, 2, 3, 4, 5, 6]}},
    {"name": "rank 3", "input": [[[1.5], [2.5]], [[3.5], [4.5]], [[5.5], [6.5]]],
     "expect": {"dtype": "DT_FLOAT", "shape": [3, 2, 1], "values": [1.5, 2.5, 3.5, 4.5, 5.5, 6.5]}},
    {"name": "int64 beyond 2^53 keeps precision", "input": [9007199254740993, -9223372036854775808],
     "expect": {"dtype": "DT_INT64", "shape": [2], "values": [9007199254740993, -9223372036854775808]}},
    {"name": "explicit float32 over integer literals", "input": {"dtype": "float32", "values": [[1, 0], [0, 4]]},
     "expect": {"dtype": "DT_FLOAT", "shape": [2, 2], "values": [1, 0, 0, 4]}},
    {"name": "explicit DT_ name and case are accepted", "input": {"dtype": "DT_DOUBLE", "values": [0.1, 2]},
     "expect": {"dtype": "DT_DOUBLE", "shape": [2], "values": [0.1, 2]}},
    {"name": "explicit int32", "input": {"dtype": "int32", "values": [1, -2, 2147483647]},
     "expect": {"dtype": "DT_INT32", "shape": [3], "values": [1, -2, 2147483647]}},
    {"name": "explicit uint8", "input": {"dtype": "uint8", "values": [[0, 255]]},
     "expect": {"dtype": "DT_UINT8", "shape": [1, 2], "values": [0, 255]}},
    {"name": "explicit int8 and int16", "input": {"dtype": "int16", "values": [-32768, 32767]},
     "expect": {"dtype": "DT_INT16", "shape": [2], "values": [-32768, 32767]}},
    {"name": "explicit uint32", "input": {"dtype": "uint32", "values": [4294967295]},
     "expect": {"dtype": "DT_UINT32", "shape": [1], "values": [4294967295]}},
    {"name": "explicit uint64 max", "input": {"dtype": "uint64", "values": [18446744073709551615]},
     "expect": {"dtype": "DT_UINT64", "shape": [1], "values": [18446744073709551615]}},
    {"name": "explicit shape reshapes flat values", "input": {"dtype": "float32", "shape": [2, 3], "values": [0, 1, 2, 3, 4, 5]},
     "expect": {"dtype": "DT_FLOAT", "shape": [2, 3], "values": [0, 1, 2, 3, 4, 5]}},
    {"name": "explicit shape without dtype still infers", "input": {"shape": [2, 1], "values": ["a", "b"]},
     "expect": {"dtype": "DT_STRING", "shape": [2, 1], "values": ["a", "b"]}},
    {"name": "empty tensor with dtype", "input": {"dtype": "float32", "values": []},
     "expect": {"dtype": "DT_FLOAT", "shape": [0], "values": []}},
    {"name": "empty rows keep outer dimension", "input": {"dtype": "int64", "values": [[], []]},
     "expect": {"dtype": "DT_INT64", "shape": [2, 0], "values": []}},
    {"name": "explicit bytes alias", "input": {"dtype": "bytes", "values": [{"b64": "AAH/"}]},
     "expect": {"dtype": "DT_STRING", "shape": [1], "b64_values": ["AAH/"]}},

    {"name": "ragged rows", "input": [[1, 2], [3]], "error": true},
    {"name": "scalar next to list", "input": [1, [2]], "error": true},
    {"name": "list next to empty list", "input": [[], 1], "error": true},
    {"name": "string mixed with number", "input": ["a", 1], "error": true},
    {"name": "bool mixed with number", "input": [true, 1], "error": true},
    {"name": "null leaf", "input": [1, null], "error": true},
    {"name": "empty without dtype", "input": [], "error": true},
    {"name": "int32 overflow", "input": {"dtype": "int32", "values": [2147483648]}, "error": true},
    {"name": "negative for uint8", "input": {"dtype": "uint8", "values": [-1]}, "error": true},
    {"name": "decimal for integer dtype", "input": {"dtype": "int64", "values": [1.5]}, "error": true},
    {"name": "number for bool dtype", "input": {"dtype": "bool", "values": [1]}, "error": true},
    {"name": "number for string dtype", "input": {"dtype": "string", "values": [1]}, "error": true},
    {"name": "shape does not match element count", "input": {"dtype": "float32", "shape": [2, 2], "values": [1, 2, 3]}, "error": true},
    {"name": "negative dimension", "input": {"dtype": "float32", "shape": [-1, 3], "values": [1, 2, 3]}, "error": true},
    {"name": "unknown dtype", "input": {"dtype": "complex128", "values": [1]}, "error": true},
    {"name": "spec without values", "input": {"dtype": "float32"}, "error": true},
    {"name": "unknown key in spec", "input": {"dtype": "float32", "values": [1], "shapes": [1]}, "error": true},
    {"name": "bad base64", "input": [{"b64": "!!!"}], "error": true}
  ]
}
