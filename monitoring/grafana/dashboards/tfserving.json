{
  "uid": "tfserving",
  "title": "TensorFlow Serving",
  "tags": [
    "tfserving"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(:tensorflow:serving:request_count[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error ratio",
      "description": "Share of requests whose status is not OK.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(:tensorflow:serving:request_count{status!=\"OK\"}[$__rate_interval])) / sum(rate(:tensorflow:serving:request_count[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 request latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(:tensorflow:serving:request_latency_bucket{}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed model loads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(:tensorflow:cc:saved_model:load_attempt_count{status!=\"success\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests / s by model and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name, status) (rate(:tensorflow:serving:request_count[$__rate_interval]))",
          "legendFormat": "{{model_name}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request latency by model and API (p50 / p99)",
      "description": "End-to-end time in the server, from request decode to response encode. API is empty for status/metadata calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model_name, API, entrypoint) (rate(:tensorflow:serving:request_latency_bucket{}[$__rate_interval])))",
          "legendFormat": "p50 {{model_name}} {{API}} {{entrypoint}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, model_name, API, entrypoint) (rate(:tensorflow:serving:request_latency_bucket{}[$__rate_interval])))",
          "legendFormat": "p99 {{model_name}} {{API}} {{entrypoint}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model run time (p50 / p99)",
      "description": "Time spent running the model graph only. A large gap to request latency points at batching queues or (de)serialization.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model_name, API) (rate(:tensorflow:serving:runtime_latency_bucket{}[$__rate_interval])))",
          "legendFormat": "p50 {{model_name}} {{API}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, model_name, API) (rate(:tensorflow:serving:runtime_latency_bucket{}[$__rate_interval])))",
          "legendFormat": "p99 {{model_name}} {{API}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Batching: queueing delay (p99) and batch size",
      "description": "Executed batch size includes padding up to allowed_batch_sizes; compare with rows per request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(:tensorflow:serving:batching_session:queuing_latency_bucket[$__rate_interval])))",
          "legendFormat": "queueing p99"
        },
        {
          "refId": "B",
          "expr": "sum(rate(:tensorflow:serving:batching_session:processed_batch_size_sum[$__rate_interval])) / sum(rate(:tensorflow:serving:batching_session:processed_batch_size_count[$__rate_interval]))",
          "legendFormat": "avg executed batch size"
        },
        {
          "refId": "C",
          "expr": "sum(rate(:tensorflow:serving:batching_session:input_batch_size_sum[$__rate_interval])) / sum(rate(:tensorflow:serving:batching_session:input_batch_size_count[$__rate_interval]))",
          "legendFormat": "avg rows per request"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Model loads and warmup",
      "description": "Counters only move when a version is (re)loaded: a new version directory, a config reload or a restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "µs"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": ":tensorflow:cc:saved_model:load_attempt_count",
          "legendFormat": "load {{model_path}} {{status}}"
        },
        {
          "refId": "B",
          "expr": ":tensorflow:serving:model_warmup_latency_sum / :tensorflow:serving:model_warmup_latency_count",
          "legendFormat": "warmup {{model_path}}"
        }
      ]
    }
  ]
}