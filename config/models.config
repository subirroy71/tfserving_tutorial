# Which models the server loads, where from, and which versions.
# Text-format ModelServerConfig (tensorflow_serving/config/model_server_config.proto).
# The server re-reads this file every --model_config_file_poll_wait_seconds.
model_config_list {
  config {
    name: "demo"
    base_path: "/models/demo"
    model_platform: "tensorflow"
    # Keep both versions loaded so requests can pick one by number or label.
    model_version_policy {
      specific {
        versions: 1
        versions: 2
      }
    }
    version_labels { key: "stable" value: 1 }
    version_labels { key: "canary" value: 2 }
  }
  config {
    name: "iris"
    base_path: "/models/iris"
    model_platform: "tensorflow"
    # No policy: the default is "latest", i.e. the highest version number.
  }
}
