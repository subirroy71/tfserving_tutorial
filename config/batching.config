# Server-side batching (--enable_batching). Concurrent requests to the same
# model are merged into one batch of up to max_batch_size rows; a batch is
# run when it is full or batch_timeout_micros after its first request.
max_batch_size { value: 32 }
batch_timeout_micros { value: 2000 }
max_enqueued_batches { value: 100 }
num_batch_threads { value: 4 }
# Pad batches to one of these sizes so the model sees few distinct shapes.
allowed_batch_sizes: 8
allowed_batch_sizes: 16
allowed_batch_sizes: 32
